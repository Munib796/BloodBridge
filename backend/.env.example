# --- Required ------------------------------------------------------------
DATABASE_URL=


# --- JWT (optional; defaults shown) -------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_TOKEN_EXPIRE_MINUTES=60

# --- Web -----------------------------------------------------------------
# Used to build verification / reset links.
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed browser origins. Defaults to FRONTEND_URL.
# Never "*" — the API uses bearer tokens, and browsers reject a wildcard
# alongside credentials anyway.
CORS_ORIGINS=
# Set true only behind a proxy you control, so rate limiting keys on
# X-Forwarded-For rather than the proxy's own IP.
TRUST_PROXY=false

# --- Database pool (optional; defaults shown) ---------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Accounts ------------------------------------------------------------
# Donors/requestors must verify their email before logging in. Set false for
# local work without an SMTP server, otherwise nobody can ever verify.
REQUIRE_EMAIL_VERIFICATION=true

# --- Mail (optional) -----------------------------------------------------
# Leave blank to run without email: signup still works, and verification /
# reset messages are logged as skipped instead of failing the request.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=BloodBridge

# --- Cloudinary (optional) ----------------------------------------------
# Leave blank to run without image uploads; those endpoints return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Hardcoded admin -----------------------------------------------------
# Admin login is disabled (503) while either of these is blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=
